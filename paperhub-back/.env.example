# Spring Boot reads environment variables; it does not load this file automatically.
# Use your IDE run configuration or shell environment. Never commit real credentials.
PAPERHUB_PORT=8080
PAPERHUB_DB_URL=jdbc:mysql://127.0.0.1:3306/paperhub?connectionTimeZone=Asia/Shanghai
PAPERHUB_DB_USERNAME=paperhub
PAPERHUB_DB_PASSWORD=
# Base64-encoded cryptographically random key, at least 32 decoded bytes. No default key.
PAPERHUB_JWT_SECRET=
PAPERHUB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PAPERHUB_STORAGE_ROOT=./data/storage
PAPERHUB_CLEANUP_ENABLED=true
